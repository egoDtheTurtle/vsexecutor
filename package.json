{
  "name": "vsexecutor",
  "displayName": "VSExecutor",
  "description": "Execute Roblox Lua scripts from VS Code.",
  "version": "0.0.7",
  "publisher": "egoDtheTurtle",
  "repository": {
    "type": "git",
    "url": "https://github.com/egoDtheTurtle/VSExecutor"
  },
  "files": [
    "out/**/*",
    "src/vsexecutor.lua",
    "server.js",
    "README.md",
    "LICENSE.md",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "tsc -p ./ --noEmit",
    "pretest": "npm run compile",
    "test": "node --test test/**/*.test.js",
    "watch": "tsc -w"
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:lua"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.executeFile",
        "title": "VSExecutor: Execute Main Editor"
      },
      {
        "command": "extension.copyIPv4",
        "title": "VSExecutor: Get Ethernet IPv4"
      },
      {
        "command": "extension.copyAutoexec",
        "title": "VSExecutor: Copy Autoexec Script"
      },
      {
        "command": "extension.refreshClients",
        "title": "VSExecutor: Refresh Clients"
      },
      {
        "command": "extension.openOutputViewer",
        "title": "VSExecutor: Open Output Viewer"
      }
    ],
    "views": {
      "explorer": [
          {
            "id": "executeLuaFile",
            "name": "Execute Script"
          }
      ]
    },
    "configuration": {
      "title": "VSExecutor",
      "properties": {
        "vsexecutor.host": {
          "type": "string",
          "default": "localhost",
          "description": "Host where the shared VSExecutor bridge is running."
        },
        "vsexecutor.port": {
          "type": "number",
          "default": 1306,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port used by the shared VSExecutor bridge."
        },
        "vsexecutor.defaultLoaderMode": {
          "type": "string",
          "enum": [
            "websocket",
            "loadstring"
          ],
          "default": "websocket",
          "description": "Default mode preselected by the autoexec-copy command. The Lua options table remains the execution source of truth."
        }
      }
    }
  },
  "dependencies": {
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.5.13",
    "typescript": "^4.9.5",
    "vsce": "^1.97.0"
  }
}
